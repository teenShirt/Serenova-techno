# SerenovaTech Server Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serenova_tech_cms

# Security & Secrets
JWT_SECRET=change_this_to_a_secure_random_secret_in_production_2026

# Seed Administrator Credentials (used by seedAdmin.js)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@serenovatech.com
INITIAL_ADMIN_PASSWORD=AdminSecurePass2026!
